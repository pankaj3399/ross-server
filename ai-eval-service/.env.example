ENV=production
HOST=0.0.0.0
LIGHTWEIGHT_EVAL_MODE=true
# HTTP connection limit (requests queue). Model inference is serialized in-process.
MAX_CONCURRENT_REQUESTS=10
MAX_REQUESTS=1000
PORT=8000
TOXICITY_BATCH_SIZE=1
TOXICITY_CLASSIFIERS=
# Optional: Hugging Face token for faster/more reliable model downloads on startup
HF_TOKEN=
